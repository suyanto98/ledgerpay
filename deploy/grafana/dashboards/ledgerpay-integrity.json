    {
      "id": 10,
      "type": "timeseries",
      "title": "Wallet lock wait p95 by purpose",
      "description": "E-1: purpose=PAYMENT naik tajam saat satu merchant mendekati ±120 pembayaran/dtk (docs/performance.md)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le, purpose) (rate(ledgerpay_ledger_lock_wait_seconds_bucket[5m])))",
