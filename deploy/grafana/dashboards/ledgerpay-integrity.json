{
  "uid": "ledgerpay-integrity",
  "title": "LedgerPay — Integrity & Recon",
  "description": "Apakah ledger masih benar, apakah catatan kita cocok dengan provider, dan apakah backup masih jalan?",
  "tags": [
    "ledgerpay"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "INV: balance drift accounts",
      "description": "LI-03. Runbook: docs/runbook.md#ledgerinvariantviolated",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "max(ledgerpay_ledger_balance_drift_accounts)",
          "legendFormat": "drift"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "INV: unbalanced journals",
      "description": "LI-01",
